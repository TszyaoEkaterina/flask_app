# === Node.js (React) - client/ ===
client/node_modules/
client/build/
client/dist/
client/.cache/
client/.eslintcache
client/npm-debug.log*
client/yarn-debug.log*
client/yarn-error.log*

# React environment files
client/.env
client/.env.local
client/.env.development.local
client/.env.test.local
client/.env.production.local
